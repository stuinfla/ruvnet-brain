diff --git a/scripts/slugify-strict.mjs b/scripts/slugify-strict.mjs
new file mode 100644
index 0000000..563d60f
--- /dev/null
+++ b/scripts/slugify-strict.mjs
@@ -0,0 +1,5 @@
+// Like slugify, but drops every character that cannot appear in a URL slug.
+import { slugify } from './slugify.mjs';
+export function slugifyStrict(title) {
+  return slugify(String(title).replace(/[^A-Za-z0-9\s-]/g, ''));
+}
