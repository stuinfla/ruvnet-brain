+import { expect, it } from 'vitest';
+import { slugifyStrict } from '../../scripts/slugify-strict.mjs';
+
+it('drops punctuation from the strict slug', () => {
+  expect(slugifyStrict('Hello, World!')).toBe('hello-world');
+});
