{
  "name": "ruvnet-brain-kb",
  "version": "1.9.3-dev",
  "private": true,
  "type": "module",
  "description": "Self-contained RVF knowledge base for ruvnet-brain, built by rvf-kb-forge. Run `npm i` here, then use forge-ask.mjs (CLI) or forge-mcp.mjs (MCP stdio server). Vectors live in ruvnet-brain.rvf; full passage text in ruvnet-brain.passages.jsonl.",
  "bin": {
    "forge-ask": "./forge-ask.mjs",
    "forge-mcp": "./forge-mcp.mjs"
  },
  "scripts": {
    "ask": "node forge-ask.mjs --dir . --name ruvnet-brain --q",
    "mcp": "KB_DIR=. KB_NAME=ruvnet-brain node forge-mcp.mjs",
    "guard": "node forge-guard.mjs --dir . --name ruvnet-brain",
    "score": "node forge-score.mjs --dir . --name ruvnet-brain --repo",
    "grade": "node forge-grade.mjs --dir . --name ruvnet-brain --questions questions.json",
    "big": "node forge-big.mjs both --dir . --name ruvnet-brain"
  },
  "dependencies": {
    "@ruvector/rvf": "0.2.3",
    "@xenova/transformers": "2.17.2"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "protobufjs": ">=7.5.5"
  }
}
