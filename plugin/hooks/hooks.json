{
  "description": "RuvNet Brain continuity plane. The broad legacy grounding, routing, learning, and release interceptors remain retired. Only SessionStart project restoration and the ledger-scoped Stop continuation handler are automatic; both are advisory, bounded, and fail open.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-shim.mjs\" session-start || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-shim.mjs\" memory-ensure || true",
            "timeout": 3,
            "description": "ADR-076: Recall last 3 checkpoints from memory at session start"
          }
        ]
      }
    ],
    "PostEdit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-shim.mjs\" memory-store-decisions || true",
            "timeout": 5,
            "description": "ADR-076: Capture consequential file edits (ADR, version, config) to memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-shim.mjs\" continuation-gate || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-shim.mjs\" memory-snapshot-threads || true",
            "timeout": 5,
            "description": "ADR-076: Snapshot open issues/PRs and tasks for session continuity"
          }
        ]
      }
    ]
  }
}
