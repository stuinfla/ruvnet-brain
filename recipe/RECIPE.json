{
  "schema": "ruvnet-brain/recipe",
  "version": 1,
  "id": "r2-wave1",
  "units": {
    "passage": {
      "chunker": { "name": "lines", "version": 1, "maxLines": 400, "maxChars": 8000 },
      "header": "repo-path-symbol",
      "symbolChunker": {
        "name": "symbol",
        "version": 1,
        "portOf": "kb/forge-chunk-v2.mjs + kb/forge-chunk-code-v2.mjs heuristic path (branch worktree-agent-a00e59ae16c567ff6)",
        "maxTokens": 480,
        "groupTarget": 200,
        "labelTokens": 40,
        "specialTokens": 2,
        "headerSeparator": " › ",
        "maxSymbolChars": 120,
        "tokenEstimator": { "name": "approx-wordpiece", "version": 1, "lettersPerToken": 5, "digitsPerToken": 3 }
      }
    },
    "history": {
      "splitChars": 1600,
      "headerSeparator": " › ",
      "minCommitChars": 60,
      "minReleaseBodyChars": 200,
      "skipCommitSubjects": ["^Merge (pull request|branch|remote-tracking|commit)\\b"],
      "versionCommitSubjects": ["^((chore|release|build)(\\([^)]*\\))?:\\s*)?(bump|release|version|publish)\\b[^\\n]*\\d+\\.\\d+", "^v?\\d+\\.\\d+\\.\\d+([-.\\w]*)?$"],
      "versionCommitMaxChars": 200,
      "kinds": ["commit", "issue", "pr", "comment", "release"],
      "standing": { "commit": "implemented", "pr": "implemented", "issue": "planned", "comment": "spoken", "release": "claimed" },
      "perPage": 100
    }
  },
  "sources": {
    "include": [".md", ".mdx", ".txt", ".rst", ".rs", ".ts", ".tsx", ".mts", ".cts", ".js", ".mjs", ".cjs", ".jsx", ".py", ".go", ".c", ".cpp", ".h", ".hpp", ".java", ".rb", ".swift", ".kt", ".sh", ".sql", ".proto", ".json", ".yaml", ".yml", ".toml", ".ini", ".cfg"],
    "excludeDirs": ["node_modules", "target", ".git", "dist", ".next", ".cache", "coverage", ".venv", "venv", "__pycache__", ".vite", "vendor"],
    "sourceFile": ".source.json",
    "contentTypes": {
      "markdown": [".md", ".mdx"],
      "text": [".txt", ".rst"],
      "tree": [".json", ".yaml", ".yml"],
      "sections": [".toml", ".ini", ".cfg"],
      "code": [".rs", ".ts", ".tsx", ".mts", ".cts", ".js", ".mjs", ".cjs", ".jsx", ".py", ".go", ".c", ".cpp", ".h", ".hpp", ".java", ".rb", ".swift", ".kt", ".sh", ".sql", ".proto"]
    },
    "buildDirBesideManifests": ["package.json", "Cargo.toml", "setup.py", "pyproject.toml", "CMakeLists.txt", "Makefile", "build.gradle", "pom.xml", "go.mod", "meson.build"],
    "skipFileNames": ["package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "yarn.lock", "bun.lockb", "Cargo.lock", "poetry.lock", "composer.lock", "Gemfile.lock", "go.sum"],
    "skipPathPatterns": ["\\.(min\\.js|min\\.css|lock)$", "(^|/)evals/(runs|oracles)(/|$)"],
    "generatedPattern": "@generated|DO NOT EDIT|auto-generated by|autogenerated by|generated by wasm-bindgen|this file is generated",
    "maxFileBytes": 1500000,
    "configMaxChars": 12000
  },
  "standing": { "docExtensions": [".md", ".mdx", ".txt", ".rst"], "doc": "claimed", "code": "implemented", "byKind": { "adr": "decided" } },
  "screen": {
    "redaction": "[redacted]",
    "secrets": [
      { "rule": "aws-access-key", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
      { "rule": "github-token", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b" },
      { "rule": "github-pat", "pattern": "\\bgithub_pat_[A-Za-z0-9_]{50,}\\b" },
      { "rule": "api-key-sk", "pattern": "\\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{32,}" },
      { "rule": "slack-token", "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}" },
      { "rule": "google-api-key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
      { "rule": "private-key", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----" }
    ],
    "hostile": [
      { "rule": "ignore-instructions", "pattern": "\\b(ignore|disregard|forget) (all |any |the )?(previous|prior|above|earlier|preceding) (instructions|prompts|directions|rules)\\b", "flags": "i" },
      { "rule": "role-override", "pattern": "\\byou are now (in )?(developer mode|dan|jailbroken|an unrestricted)", "flags": "i" },
      { "rule": "chat-markup", "pattern": "<\\|im_start\\|>|<\\|im_end\\|>|\\[INST\\]" },
      { "rule": "exfiltrate", "pattern": "\\b(reveal|print|send|exfiltrate|leak) (me )?(your|the) (system prompt|api keys?|secrets?|credentials)\\b", "flags": "i" }
    ]
  },
  "carry": { "maxShare": 0.25 },
  "analyser": {
    "name": "lucene-porter-ident",
    "fts5Tokenizer": "unicode61",
    "minTokenLength": 2,
    "minNumberLength": 4,
    "maxQueryTerms": 1000,
    "splitIdentifiers": true,
    "stemmer": "porter",
    "stopwords": ["a", "an", "and", "are", "as", "at", "be", "but", "by", "for", "if", "in", "into", "is", "it", "no", "not", "of", "on", "or", "such", "that", "the", "their", "then", "there", "these", "they", "this", "to", "was", "will", "with", "how", "what", "when", "where", "who", "why", "which", "whose", "whom", "can", "do", "does", "did", "has", "have", "had", "been", "being", "am", "were", "about", "after", "all", "also", "any", "because", "before", "below", "between", "both", "each", "few", "from", "further", "here", "i", "me", "my", "we", "us", "our", "you", "your", "he", "him", "his", "she", "her", "its", "them", "theirs", "over", "under", "than", "just", "only", "more", "most", "other", "some", "so", "too", "very", "one", "two", "three", "first", "last", "new", "old"]
  },
  "models": [],
  "lanes": [
    { "name": "lexical", "kind": "fts5-bm25", "optional": false, "role": "lexical-db", "weights": { "subject": 1, "body": 1 }, "depth": 100, "unit": "passage" },
    { "name": "history", "kind": "fts5-bm25", "optional": true, "role": "history-db", "weights": { "subject": 1, "body": 1 }, "depth": 100, "unit": "history item" }
  ],
  "sections": [
    { "name": "FILES", "lane": "lexical", "maxItems": 5, "itemChars": 8000, "budgetChars": { "brief": 20000, "full": 44000 } },
    { "name": "HISTORY", "lane": "history", "maxItems": 3, "itemChars": 2000, "budgetChars": { "brief": 4000, "full": 6000 } }
  ],
  "result": { "capChars": { "brief": 24000, "full": 60000 }, "defaultDetail": "brief" },
  "deadlineMs": 10000,
  "probes": { "perRepo": 1, "termsPerProbe": 3, "minTermLength": 4 }
}
