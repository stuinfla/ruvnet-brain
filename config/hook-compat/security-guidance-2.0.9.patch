+# Local Codex-cache compatibility boundary; review logic and exit channels stay unchanged.
+_CODEX_POST_TOOL_USE = False
+
+def _emit_codex_json(out, *, flush=False):
+    if _CODEX_POST_TOOL_USE:
+        telemetry = {key: out[key] for key in ("metrics", "rewakeSummary") if key in out}
+        if telemetry:
+            debug_log("Codex hook telemetry: " + json.dumps(telemetry))
+        out = {key: value for key, value in out.items() if key in (
+            "continue", "stopReason", "suppressOutput", "systemMessage", "decision", "reason",
+            "hookSpecificOutput")}
+        specific = out.get("hookSpecificOutput")
+        if isinstance(specific, dict):
+            out["hookSpecificOutput"] = {key: value for key, value in specific.items()
+                if key in ("hookEventName", "additionalContext")}
+        if not out:
+            return
+    print(json.dumps(out), flush=flush)
