#!/bin/sh
# RuvNet Brain — pre-push gate. NON-OPTIONAL. Runs on every `git push`.
#
# WHY (2026-07-17): a real client (Jan) hit npx ruvnet-brain@latest with a stale package whose
# self-update manifest 404'd. The root cause wasn't the bug — it was that the CHECK was optional
# and I skipped it. This hook removes the discretion: it refuses the push if the version surfaces
# disagree or the self-update manifest 404s. It does not care whether I remembered, or was in a
# hurry, or "was pretty sure it was fine." Pass or the push does not happen.
#
# It blocks ONLY on what is knowable before a push. npm-latest and the live explainer are verified
# post-publish by `node scripts/release.mjs --publish` (the only sanctioned ship path).
#
# Escape hatch is `git push --no-verify` — but if you use it, you are consciously overriding a gate
# that exists because of a specific failure that cost real user trust. Own that out loud.
#
# SECRET SCAN (2026-07-21): a buggy diagnostic echoed live OPENAI and OPENROUTER keys into a
# terminal, and AgentDB's session autocapture wrote them to .swarm/. Nothing reached git — but the
# only thing that stopped it was a GLOBAL gitignore that does not travel to a clone or another
# machine. Relying on "the file happened to be ignored" is not a control. This is: a real key
# pattern in anything being pushed refuses the push. Placeholders (your-key, abc123, xxxx,
# deadbeef, example) are excluded, because rUv's own docs are full of them and a gate that cries
# wolf on documentation is a gate people learn to bypass.
#
# SCOPE FIX (2026-07-22): this scanned `git diff --cached HEAD` — the STAGED INDEX. But a push ships
# COMMITS, and at push time the index is normally clean, so the scan read nothing. Proven both ways
# in a scratch repo: a key COMMITTED then pushed sailed through, while the same key merely STAGED was
# blocked. The gate could only catch the one case that never happens. It is the same defect class the
# 7e715bb commit fixed in the *test* — a check that cannot fail in the situation it was written for —
# which survived here in the *scan*. Now it reads the actual push range from the hook's stdin.
RANGE_DIFF=""
CURRENCY_BASE=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac        # all-zeros = branch deletion, nothing to scan
  case "$remote_sha" in
    ""|*[!0-9a-f]*|0000000000000000000000000000000000000000)  # new branch: scan its whole history vs other refs
      RANGE_DIFF="$RANGE_DIFF$(git diff --no-color -U0 "$(git merge-base HEAD origin/main 2>/dev/null || echo '')" "$local_sha" 2>/dev/null)"
      # ADR-056 §5: a new branch has no remote counterpart, so the merge-base with main is the only
      # honest base. If even that cannot resolve, CURRENCY_BASE stays empty and the currency check is
      # SKIPPED rather than run against a guess — never a scope invented from nothing.
      [ -z "$CURRENCY_BASE" ] && CURRENCY_BASE="$(git merge-base HEAD origin/main 2>/dev/null || true)" ;;
    *)
      RANGE_DIFF="$RANGE_DIFF$(git diff --no-color -U0 "$remote_sha" "$local_sha" 2>/dev/null)"
      # ADR-056: the remote tip is only a valid "what did I change" base when it is an ANCESTOR of
      # what we are pushing. After a rebase or squash it is NOT — the range then spans the entire
      # rewrite and drags in every document the upstream branch already carried, red ones included.
      # Measured 2026-07-27: a force-push after rebasing onto main was refused for ADR-054 and
      # ADR-055 — two documents on main that this branch never touched. GPT-5.6 predicted exactly
      # this in the ADR-056 duel ("rebase or squash changes the touched-file set without changing
      # whether a violation is genuinely new"). So: ancestor => use it; otherwise fall back to the
      # merge-base with main, which is the honest answer to "what is mine".
      if [ -z "$CURRENCY_BASE" ]; then
        if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
          CURRENCY_BASE="$remote_sha"
        else
          CURRENCY_BASE="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
        fi
      fi ;;
  esac
done
# Fall back to the staged index too, so a pre-commit-style invocation still gets covered.
RANGE_DIFF="$RANGE_DIFF
$(git diff --cached --no-color -U0 HEAD 2>/dev/null)"

SECRET_HITS=$(printf '%s' "$RANGE_DIFF" | grep -E "^\+" \
  | grep -oE "sk-(proj|ant|or-v1)-[A-Za-z0-9_-]{20,}" \
  | grep -vEi "your-key|abc123|xxxx+|deadbeef|example|placeholder|REDACTED" | head -3)
if [ -n "$SECRET_HITS" ]; then
  echo ""
  echo "  ⛔ PUSH BLOCKED — what looks like a REAL API key is in this push."
  echo "     matched (prefix only): $(echo "$SECRET_HITS" | cut -c1-14 | tr '\n' ' ')"
  echo "     Remove it, rotate the key, and push again. Never --no-verify past this one:"
  echo "     a key that reaches a remote is compromised the moment it lands."
  echo ""
  exit 1
fi

# Hooks may be shared by several git worktrees. Resolving from this script's own path is wrong when
# core.hooksPath names another checkout: the hook then validates that checkout while pushing the
# current one (measured 2026-07-28: announced 3.9.128, pushed 3.9.129). Git already knows the
# worktree whose refs are being pushed, so derive the shipping root from that live repository.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ] || [ ! -f "$ROOT/scripts/verify-channels.mjs" ]; then
  echo "  ⛔ pre-push gate cannot resolve the worktree being pushed."
  exit 1
fi
node "$ROOT/scripts/verify-channels.mjs" --pre-push
status=$?
if [ "$status" -ne 0 ]; then
  echo ""
  echo "  ⛔ pre-push gate refused this push. A user on some path would get a broken build."
  echo "     Fix the channel(s) above, then push again. Do not route around this."
  exit 1
fi

# Generated public census and command aliases have one source of truth each. Both writers have a
# `--check` mode specifically for CI/pre-push; until 2026-08-22 nothing invoked either check, so the
# writers were built and tested but their promised gate did not exist.
node "$ROOT/scripts/sync-census.mjs" --check
census_status=$?
if [ "$census_status" -ne 0 ]; then
  echo ""
  echo "  ⛔ pre-push gate refused this push — public census claims have drifted."
  echo "     Run: node scripts/sync-census.mjs"
  exit 1
fi

node "$ROOT/scripts/sync-commands.mjs" --check
commands_status=$?
if [ "$commands_status" -ne 0 ]; then
  echo ""
  echo "  ⛔ pre-push gate refused this push — command aliases no longer share one body."
  echo "     Run: node scripts/sync-commands.mjs"
  exit 1
fi

# The convergence manifest is the exact source/version/ADR identity consumed by hosted QA.
# Check it here so a push cannot publish a commit whose generated identity was produced before
# the final source edit (the failure mode that repeatedly escaped local pre-push validation).
node "$ROOT/scripts/convergence-manifest.mjs"
convergence_status=$?
if [ "$convergence_status" -ne 0 ]; then
  echo ""
  echo "  ⛔ pre-push gate refused this push — convergence identity is stale."
  echo "     Run: npm run convergence:write"
  exit 1
fi

# ── DOCUMENT CURRENCY (ADR-056 §5) ─────────────────────────────────────────────────────────────────
# The tool was written and tested on 2026-07-22 and then invoked by NOTHING for five days — absent
# from this hook, gate.sh, gates.mjs and every workflow, while `wired-check` reported it "wired"
# because package.json DEFINED an npm alias for it. This line is the whole fix.
#
# NO RATCHET, DELIBERATELY. The first draft of ADR-056 proposed a stateful new-vs-pre-existing
# violation tracker so this gate could coexist with 32 pre-existing BLOCKs forever. Two independent
# adversarial reviews killed it: a committed baseline is gamed by the same commit that adds the
# violation, re-deriving at the remote SHA needs a second worktree, and "report the rest forever"
# is the wolf-cry doc-currency.mjs's own header names as its designed failure mode. The debt was
# PAID instead (32 BLOCKs -> 4, all four genuine re-reads), which makes the plain gate safe.
#
# SCOPED to what this push touches. A pre-existing red document must not block someone who merely
# walked past it — that teaches people never to touch the red documents, preserving exactly the drift
# this exists to end. Scope is empty => nothing to check => pass; never a scope invented from nothing.
if [ -n "$CURRENCY_BASE" ]; then
  node "$ROOT/scripts/doc-currency.mjs" --check --changed "$CURRENCY_BASE"
  dc_status=$?
  if [ "$dc_status" -ne 0 ]; then
    echo ""
    echo "  ⛔ pre-push gate refused this push — a document you touched disagrees with its code."
    echo "     An ADR that describes a world the code left is worse than no ADR."
    echo "     \`node scripts/doc-currency.mjs --fix\` backfills every date git can prove;"
    echo "     everything else is a claim only you can make."
    exit 1
  fi
fi
echo ""
echo "  ✓ pre-push gate passed — version, channels, secrets, and document currency are clean."
echo ""
exit 0
