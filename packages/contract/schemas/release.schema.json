{
  "$id": "ruvnet-brain/release",
  "type": "object",
  "required": ["schema", "version", "releaseNumber", "minShim", "app", "pack", "signature"],
  "properties": {
    "schema": { "const": "ruvnet-brain/release" },
    "version": { "const": 1 },
    "releaseNumber": { "type": "integer", "minimum": 1 },
    "minShim": { "type": "integer", "minimum": 1 },
    "migrate": { "type": "boolean" },
    "app": {
      "type": "object",
      "required": ["version", "files"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$" },
        "files": { "$ref": "#files" }
      }
    },
    "pack": {
      "type": "object",
      "required": ["generation", "files"],
      "properties": {
        "generation": { "type": "string", "pattern": "^g-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{12}$" },
        "files": { "$ref": "#files" }
      }
    },
    "signature": {
      "type": "object",
      "required": ["alg", "keyId", "value"],
      "properties": {
        "alg": { "const": "ed25519" },
        "keyId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "value": { "type": "string", "minLength": 16 }
      }
    }
  },
  "$defs": {
    "files": {
      "$anchor": "files",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\:]+$" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
