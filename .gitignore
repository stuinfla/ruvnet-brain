# deps + caches (regenerable via npm i)
node_modules/
**/node_modules/

# build artifacts (regenerable in seconds via scripts/build-bundle.mjs)
dist/
/release-evidence/

# external source clones (themselves git repos; regenerable via self-update --include-new)
clones/
data/adrs-cache/

# Helix removed from the brain (it's a separate consumer app); kept locally, not committed
kb/_excluded-helix/

# logs + scratch
*.log
logs/
*.tmp
.DS_Store

# empty AgentDB container — runtime artifact, never commit (avoids the write-but-read-nothing clutter)
ruvector.db

# Brain store binaries are NOT committed — they ship via the GitHub Release (the 421MB bundle) so the
# repo stays light for fast clone / plugin install. Human-authored knowledge (primers, capability-cards,
# l2/, SOURCE.json) + the forge tools ARE committed; regenerate stores via ingest-repo.mjs + build-concepts.
kb/*.rvf
kb/*.passages.jsonl
kb/*.idmap.json
kb/*.embed.json
kb/*.meta.json
kb/*.symbols.json

node_modules

# secrets — NEVER commit (protection travels with the repo, not just global git excludes)
# .swarm/ holds AgentDB session autocapture, which records whatever crossed the terminal —
# including, on 2026-07-21, live API keys echoed by a buggy diagnostic. It was only fenced by a
# GLOBAL gitignore, which does not travel to a clone or another machine. Fenced here now.
.swarm/
.env
.env.*
!.env.example
*.bak

# local scratch — never ship
agentdb.rvf
agentdb.rvf.lock
deck/

# generated QE/eval test artifacts
DESCRIBED-BASELINE.md
data/described-baseline-results.json

# agentic-qe local runtime state (memory.db, dream engine) — not our source
.agentic-qe/

# bundle-signing private key (Ed25519) — NEVER commit; public key in keys/ is committed
.secrets/

# but DO commit the public signing key — it is the installer trust root
!keys/
!keys/*.pub.pem

# vitest coverage output (build artifact)
coverage/

# Agentic-QE receipts and reports are run-local evidence, uploaded per CI job.
.qe/

# metaharness evolve artifacts (variants/runs/archive) — machine-local, regenerated
.metaharness/

# gist ingest fetch-cache (machine-local; the index in docs/ is the tracked artifact)
kb/.ruv-gists.cache.json

# ruflo flywheel: the locally-applied signed retrieval-config champion (per-install state)
.claude/proven-config.json
.claude/.proven-config-version

# unattended-loop checkpoints (per-project runtime state)
.ruvnet-brain/

# RVF store advisory locks (transient, created by any query)
*.rvf.lock
.vercel

# rUv advice videos/transcripts — watched & ingested into the brain, never committed (1GB+ media)
docs/Ruv_advice/

# meeting-transcript KB store — semi-private community calls, LOCAL brain only (also fenced in kb/PRIVATE-STORES.json)
kb/ruv-meetings.*

# PRIVATE-store human-authored files (primers/cards) — fenced like the stores themselves (never commit)
kb/cognitum-seed-primer.md
kb/cognitum-seed-*.md
kb/cognitum-v0-appliance-primer.md
kb/cognitum-v0-appliance-*.md
kb/cognitum-platform-docs-primer.md
kb/cognitum-platform-docs-*.md
kb/cognitum-spoton-primer.md
kb/cognitum-spoton-*.md
kb/cognitum-trader-primer.md
kb/cognitum-trader-*.md
kb/cognitum-trader-jackishim-primer.md
kb/cognitum-trader-jackishim-*.md
kb/ruv-meetings-primer.md
kb/ruv-meetings-*.md

# stray local model cache — never commit
kb/models-cache/
.env*
.claude/worktrees/

# The 529MB knowledge bundle — a release ASSET, never repo content.
ruvnet-brain.zip
ruvnet-brain.zip.sha256
ruvnet-brain.zip.sig
